# ============================================================
# Bear Chat — konfiguracja
# Skopiuj ten plik jako .env i uzupełnij wartości:
#   cp .env.example .env
# ============================================================

# Port, na którym działa interfejs (domyślnie 3000)
PORT=3000

# --- WARIANT A: chmura NVIDIA (najprostszy start) -----------
# 1. Wejdź na https://build.nvidia.com i zaloguj się.
# 2. Wybierz model z rodziny Nemotron i kliknij "Get API Key".
# 3. Wklej klucz poniżej (zaczyna się od "nvapi-").
NVIDIA_API_KEY=

# Endpoint zgodny z API OpenAI. Dla chmury NVIDIA zostaw bez zmian.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Identyfikator modelu. Dokładną nazwę modelu Nemotron 3 znajdziesz
# na build.nvidia.com (lub w UI: Ustawienia -> "Pobierz listę").
NEMOTRON_MODEL=nvidia/nemotron-nano-9b-v2

# --- WARIANT B: model uruchomiony lokalnie ------------------
# vLLM:    NEMOTRON_BASE_URL=http://localhost:8000/v1
# Ollama:  NEMOTRON_BASE_URL=http://localhost:11434/v1
# NIM:     NEMOTRON_BASE_URL=http://localhost:8000/v1
# Przy lokalnym endpointzie klucz API zwykle nie jest wymagany.
