{
  "name": "cosmos",
  "version": "2.0.0",
  "description": "Hybrid local/cloud AI environment for multimodal models, agents, MCP and edge inference.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/uruchom.js",
    "test:szybkie": "node tests/uruchom.js szybkie",
    "audyt": "node scripts/audyt.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.cosmos.chat",
    "productName": "Cosmos",
    "files": [
      "server.js",
      "lib/**",
      "desktop/**",
      "automation/**",
      "public/**",
      ".env.example",
      "!tests/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "MIT",
  "optionalDependencies": {
    "playwright": "^1.62.0"
  }
}
